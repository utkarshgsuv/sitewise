# Sitewise env — copy to .env and fill. Never commit .env.
SITEWISE_ENV=dev                      # dev | test | demo

# Neon (pooled = runtime, direct owner = migrations/seed). See D-01.
DATABASE_URL_POOLED=postgresql+psycopg://sitewise_app:CHANGE_ME@ep-xxxx-pooler.neon.tech/neondb?sslmode=require
DATABASE_URL_MCP=postgresql+psycopg://sitewise_mcp:CHANGE_ME@ep-xxxx-pooler.neon.tech/neondb?sslmode=require
DATABASE_URL_DIRECT_OWNER=postgresql+psycopg://sitewise_owner:CHANGE_ME@ep-xxxx.neon.tech/neondb?sslmode=require

# Auth / envelope
JWT_SECRET=CHANGE_ME_32_CHARS_MIN
ENVELOPE_SECRET=CHANGE_ME_32_CHARS_MIN
MCP_URL=http://localhost:8001/mcp

# Governance (Person A owns after S1)
ARMORIQ_API_KEY=
ARMORIQ_USER_ID=
ARMORIQ_AGENT_ID=sitewise-investigator
ARMORIQ_MODE=A                        # A | B (after spike S1)

# Models
GOOGLE_API_KEY=
LLM_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Runtime caps
RUN_MAX_TOOL_ATTEMPTS=25
GOVERNANCE_TIMEOUT_S=8
